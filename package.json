{
  "name": "huaji-agent",
  "version": "1.0.0",
  "description": "Flue agent for HuaJiBot signed ingress and Cloudflare Queue replies",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:runtime": "node scripts/test-runtime.ts",
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && npm run contracts:check",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "contracts:check": "node scripts/generate-contracts.ts --check",
    "dev:debug": "node scripts/dev-debug.ts",
    "smoke:development": "node --env-file-if-exists=.dev.vars scripts/smoke-development.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@flue/runtime": "^2.2.2",
    "@flue/vite": "^2.2.2",
    "hono": "^4.13.12",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.4",
    "@valibot/to-json-schema": "^1.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "protobufjs@7.6.6": true
  }
}
